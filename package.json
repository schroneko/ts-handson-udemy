{
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.31.0",
    "@typescript-eslint/parser": "^5.31.0",
    "eslint": "^8.20.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4"
  },
  "scripts": {
    "lint": "eslint --ext ts,tsx .",
    "lint:fix": "eslint --ext ts,tsx --fix .",
    "test:security": "node --test tests/glob-migration.test.cjs"
  },
  "overrides": {
    "postcss": "8.5.28",
    "flatted": "3.4.2",
    "fast-glob": "$fast-glob",
    "micromatch": "$micromatch",
    "chokidar": "$chokidar",
    "picomatch@2": "2.3.2",
    "minimatch@3": "3.1.4",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7"
  },
  "dependencies": {
    "fast-glob": "file:./vendor/glob-compat",
    "micromatch": "file:./vendor/match-compat",
    "chokidar": "file:./vendor/watch-compat"
  }
}
